# Used by docker-compose.yml only. Copy to ".env" in this same directory
# before running `docker compose up`. For running backend/frontend directly
# with npm (without Docker), use backend/.env.example and frontend/.env.example
# instead.

POSTGRES_USER=kanban
POSTGRES_PASSWORD=kanban_dev_password
POSTGRES_DB=kanban

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3000

# Must be the URL the BROWSER can reach, not the "backend" Docker-internal
# hostname - API calls happen client-side.
NEXT_PUBLIC_API_URL=http://localhost:3001
