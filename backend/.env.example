# PostgreSQL connection string used by Prisma.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://kanban:kanban_dev_password@localhost:5432/kanban?schema=public"

# Used only for running migrations against a POOLED connection (e.g. Neon,
# PgBouncer) where DATABASE_URL can't run DDL. For plain Postgres (local/
# Docker) this can just be the same value as DATABASE_URL.
DIRECT_URL="postgresql://kanban:kanban_dev_password@localhost:5432/kanban?schema=public"

# Secret used to sign JWT access tokens. Use a long random string in real deployments.
JWT_SECRET="replace-with-a-long-random-secret"

# JWT access token lifetime.
JWT_EXPIRES_IN="7d"

# Port the NestJS server listens on.
PORT=3001

# Comma-separated list of origins allowed to call the API (CORS).
CORS_ORIGIN="http://localhost:3000"
